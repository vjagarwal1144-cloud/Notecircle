# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# NoteCircle transactional email
# For a personal Gmail sender, enable 2-Step Verification and create a Gmail App Password.
# Never put your normal Gmail password in the app or repository.
EMAIL_PROVIDER="gmail"
SMTP_USER="your-personal-email@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
EMAIL_FROM="NoteCircle <your-personal-email@gmail.com>"
ADMIN_EMAIL="your-personal-email@gmail.com"
# Optional overrides. Gmail defaults are used automatically when EMAIL_PROVIDER=gmail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
# Optional alternative provider:
# RESEND_API_KEY="re_xxxxxxxxx"
